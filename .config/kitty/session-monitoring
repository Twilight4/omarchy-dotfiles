# Monitoring session (SUPER+ special workspace, ws-monitoring): btop only,
# plus the audio tab — pulsemixer controls on top, cava visualizer in the
# smaller bottom split (~25%).
#
# kitty quirk: a splits-layout tab silently never spawns when it is the last
# of five tabs in this session file (verified: works as tab 2) — keep the
# audio tab directly after btop.

# Tab 1: btop
layout tall
cd ~/
launch --title btop sh -c 'btop'
focus

# Tab 2: audio
new_tab audio
layout splits
cd ~/
launch --title pulsemixer sh -c 'pulsemixer'
launch --location=hsplit --bias 25 --title cava sh -c 'cava'
