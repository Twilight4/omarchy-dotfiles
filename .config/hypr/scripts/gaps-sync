#!/usr/bin/env bash
# Gaps follow the bar/dock: while the Omarchy bar or the nwg dock is visible,
# keep the normal gaps (Omarchy defaults 5/10); with both hidden, tile
# edge-to-edge. Bar state = omarchy-toggle flag file (the shell watches it);
# dock state = the process. Called from bar-toggle, dock-toggle.sh and
# autostart; the dock also fires Hyprland layer events (looknfeel.lua).
set -euo pipefail

if [[ ! -f $HOME/.local/state/omarchy/toggles/bar-off ]] || pgrep -f nwg-dock-hyprland >/dev/null; then
  hyprctl eval 'hl.config({general={gaps_in=5,gaps_out=10}})' >/dev/null
else
  hyprctl eval 'hl.config({general={gaps_in=0,gaps_out=0}})' >/dev/null
fi
