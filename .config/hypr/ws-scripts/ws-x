#!/bin/bash
# X (Twitter) web app on workspace 6 (SUPER+E). WEBAPP_WS=6 pins the launch
# to ws6 via the patched omarchy-launch-webapp. X runs in its own zen profile
# with Hyprland class webapp-x-com (MOZ_APP_REMOTINGNAME in the launcher), so
# "is X running" is a direct class match — no zen/ws heuristics.
is_x_running() {
  hyprctl clients -j | jq -e '.[] | select(.class == "webapp-x-com")' >/dev/null
}

hyprctl dispatch 'hl.dsp.focus({workspace=6})'

if ! is_x_running; then
  WEBAPP_WS=6 omarchy-launch-webapp https://x.com/home
fi
