{
  // Taeryn's menu overrides, merged over the stock definitions. User entries
  // are normalized before the merge, so rows here re-declare every stock field
  // they keep (a partial override resets the rest). Rows are hidden with
  // "when": "false" down to every descendant, or search would still surface
  // them (search checks each row's own guard only). Regenerate that block
  // after an omarchy update adds stock entries:
  //   grep -oE '^  "[a-z0-9._-]+"' /usr/share/omarchy/default/omarchy/omarchy-menu.jsonc \
  //     | tr -d ' "' | grep -E '^(learn|system|update|install\.(aur|service|development|editor|terminal|browser|ai|style\.font)|remove\.(development|browser|preinstalls)|style\.(font|hyprland))(\.|$)' | sort

  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps","when":"false"},
  "update": {"icon":"","label":"Update","aliases":[],"action":"omarchy-launch-floating-terminal-with-presentation omarchy-update"},
  "style.unlock": {"icon":"󰟵","label":"Unlock","aliases":["unlock"],"action":"omarchy-shell lock explore","description":"Preview and choose a lock screen design"},
  "install.package": {"icon":"󰣇","label":"Package","action":"xdg-terminal-exec --app-id=org.omarchy.terminal $HOME/.config/hypr/scripts/pkg-install","description":"Search official repos and the AUR together"},
  "install.style.theme": {"icon":"󰸌","label":"Theme","action":"omarchy-launch-floating-terminal-with-presentation omarchy-theme-install","parent":"install"},
  "install.style.background": {"icon":"","label":"Background","action":"omarchy-theme-bg-install","parent":"install"},
  "style.hyprland": {"when": "false"},

  // Toggle menu: hide Window Gaps (gaps are driven by the bar/dock
  // visibility, looknfeel.lua). Workspace Layout is re-homed to our
  // master <-> scrolling toggle (stock cycles dwindle <-> scrolling, but
  // general:layout is pinned to master on this box).
  "trigger.toggle.window-gaps": {"when": "false"},
  "trigger.toggle.workspace-layout": {"icon":"󱂬","label":"Workspace Layout","aliases":["layout","scrolling","master"],"action":"$HOME/.config/hypr/scripts/layout-toggle.sh"},

  // Share > PrivateBin: paste the clipboard or a picked file to
  // privatebin.net (privatebin CLI); the URL lands in the clipboard.
  "trigger.share.privatebin": {"icon":"󰌷","label":"PrivateBin","aliases":["privatebin","paste","bin"]},
  "trigger.share.privatebin.clipboard": {"icon":"","label":"Clipboard","action":"$HOME/.config/hypr/scripts/privatebin-share clipboard"},
  "trigger.share.privatebin.file": {"icon":"","label":"File","action":"$HOME/.config/hypr/scripts/privatebin-share file"},


  // Setup > Config > Hyprland: submenu of ~/.config/hypr/ configs, opened in the
  // running Emacs (emacsclient -n). Keybindings/Monitors/Input moved in from Setup.
  "setup.config.hyprland": {"icon":"","label":"Hyprland","aliases":["hyprland configs"]},
  "setup.config.hyprland.main": {"icon":"","label":"Main","aliases":["hyprland.lua"],"action":"emacsclient -n \"$HOME/.config/hypr/hyprland.lua\"","description":"hyprland.lua"},
  "setup.keybindings": {"icon":"","label":"Keybindings","aliases":[],"when":"[[ -f ~/.config/hypr/bindings.lua ]]","parent":"setup.config.hyprland","action":"emacsclient -n \"$HOME/.config/hypr/bindings.lua\"","description":"bindings.lua"},
  "setup.monitors": {"icon":"󰍹","label":"Monitors","aliases":[],"parent":"setup.config.hyprland","action":"emacsclient -n \"$HOME/.config/hypr/monitors.lua\"","description":"monitors.lua"},
  "setup.input": {"icon":"","label":"Input","aliases":[],"when":"[[ -f ~/.config/hypr/input.lua ]]","parent":"setup.config.hyprland","action":"emacsclient -n \"$HOME/.config/hypr/input.lua\"","description":"input.lua"},
  "setup.config.hyprland.windowrules": {"icon":"","label":"Window Rules","aliases":["windowrules"],"action":"emacsclient -n \"$HOME/.config/hypr/windowrules.lua\"","description":"windowrules.lua"},
  "setup.config.hyprland.looknfeel": {"icon":"󰍹","label":"Look & Feel","aliases":["looknfeel"],"action":"emacsclient -n \"$HOME/.config/hypr/looknfeel.lua\"","description":"looknfeel.lua"},
  "setup.config.hyprland.autostart": {"icon":"","label":"Autostart","aliases":["autostart"],"action":"emacsclient -n \"$HOME/.config/hypr/autostart.lua\"","description":"autostart.lua"},

