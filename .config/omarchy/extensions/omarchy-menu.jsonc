  // Web apps menu (SUPER+S / bar globe button): one row per tracked
  // .desktop entry in omarchy-dotfiles/.local/share/applications. Adding a
  // webapp via the installer = copy the .desktop into the repo + one row here.
  "webapps": {"icon":"󰀹","label":"Web apps","aliases":["webapps","web apps","sites","www"]},
  "webapps.youtube": {"icon":"","appIcon":"youtube","label":"YouTube","parent":"webapps","action":"uwsm-app -- gtk-launch Youtube.desktop","description":"youtube.com"},
  "webapps.netflix": {"icon":"","appIcon":"netflix","label":"Netflix","parent":"webapps","action":"uwsm-app -- gtk-launch Netflix.desktop","description":"netflix.com"},
  "webapps.olx": {"icon":"","appIcon":"olx","label":"OLX","parent":"webapps","action":"uwsm-app -- gtk-launch OLX.desktop","description":"olx.pl"},
