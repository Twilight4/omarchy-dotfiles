#!/bin/bash

# omarchy:summary=Launch a URL as a web app in the default supported browser
# omarchy:args=<url>
#
# PATCHED (omarchy-dotfiles/.config/omarchy-patches): zen is Firefox-family
# and has no chromeless --app mode, so every web app runs in its OWN zen
# profile ("webapp-<domain>") with its own app id (MOZ_APP_REMOTINGNAME ->
# Hyprland class "webapp-<domain>"). One profile per app because zen's
# remote --new-window seeds the new window with the WHOLE live session of the
# profile — with a shared profile every launch resurrected every other open
# web app as extra tabs. Distinct classes also dodge the class=zen -> ws2
# window rule, which used to drag the view to ws2 and back on every launch.
#
# Launching a web app that is already running focuses its window instead of
# opening a duplicate (one window per app, so one tab set per app).
#
# env -u BROWSER: a stale BROWSER env (e.g. brave) makes xdg-settings return a
# bogus id (observed: imv.desktop), silently skipping the zen case.

# Workspace pin: the WEBAPP_WS env overrides per launch (e.g. X.desktop pins
# X to ws 6); unset = the workspace FOCUSED at launch ("open where I am").
# Fallback 7 covers special workspaces (negative ids can't tag an exec).
WEBAPP_WS="${WEBAPP_WS:-$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // empty')}"
[[ $WEBAPP_WS =~ ^[0-9]+$ ]] || WEBAPP_WS=7

browser=$(env -u BROWSER xdg-settings get default-web-browser)

case $browser in
zen*)
  prof="webapp-$(printf '%s' "$1" | sed -E 's#^[a-z]+://(www\.)?##; s#/.*##; s#[^a-z0-9.-]##g; s#\.#-#g')"
  pdir="$HOME/.config/zen/$prof"

  # Already running → focus its window. Never spawn a duplicate window.
  addr=$(hyprctl -j clients | jq -r --arg c "$prof" '.[] | select(.class == $c) | .address' | head -1)
  if [ -n "$addr" ]; then
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null 2>&1 || hyprctl dispatch focuswindow "address:$addr"
    exit 0
  fi

  # Self-heal: create the dedicated profile once. user.js pre-seeds
  # welcome/default-browser chrome off and session restore off — plus
  # zen.urlbar.open-on-startup=false, which stops zen opening an extra blank
  # tab at every startup.
  fresh=0
  grep -q "^Name=$prof$" ~/.config/zen/profiles.ini 2>/dev/null || \
    { zen-browser -CreateProfile "$prof $pdir" || exit 1; fresh=1; }
  mkdir -p "$pdir"
  printf '%s\n' \
    'user_pref("zen.welcome-screen.seen", true);' \
    'user_pref("browser.shell.checkDefaultBrowser", false);' \
    'user_pref("datareporting.policy.dataSubmissionEnabled", false);' \
    'user_pref("browser.startup.page", 1);' \
    'user_pref("browser.startup.homepage", "about:blank");' \
    'user_pref("browser.sessionstore.resume_from_crash", false);' \
    'user_pref("zen.urlbar.open-on-startup", false);' \
    > "$pdir/user.js"

  # One-time headless touch on a fresh profile: consumes zen's first-run
  # welcome/setup so the first real window comes up straight on the URL.
  [ "$fresh" = 1 ] && timeout 90 zen-browser -P "$prof" --headless --screenshot /dev/null about:blank >/dev/null 2>&1

  # New web app: its class joins the dock's ignore list (frozen at dock
  # start) — relaunch the dock hidden so the new window never shows there.
  [[ $fresh = 1 ]] && "$HOME/.config/hypr/scripts/dock-toggle.sh" --refresh >/dev/null 2>&1 || true

  # Cold start: the exec workspace tag lands the window on WEBAPP_WS by
  # itself — no post-map move, no workspace detour.
  hyprctl dispatch "hl.dsp.exec_cmd([=[[workspace $WEBAPP_WS] uwsm app -- env MOZ_APP_REMOTINGNAME=$prof zen-browser -P $prof $1]=])" >/dev/null
  exit 0
  ;;
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*) browser="chromium.desktop" ;;
esac

exec setsid uwsm-app -- $(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,~/.nix-profile,/usr}/share/applications/$browser 2>/dev/null | head -1) --app="$1" "${@:2}"
