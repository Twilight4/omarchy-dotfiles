#!/bin/bash

# omarchy:summary=Run the Omarchy screensaver using random effects from TTE.

# Taeryn patch: dispatch on ~/.config/omarchy/screensaver-tool to run a TUI
# screensaver (tty-clock, cmatrix, pipes, asciiquarium, cbonsai, rain)
# instead of the TTE branding effects. Unknown choice or missing binary
# falls back to stock TTE. Picked from Super+Space > Style > Screensaver.

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1
}

screensaver_pid=""
tool_fifo=""

exit_screensaver() {
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
  [[ -n $screensaver_pid ]] && kill "$screensaver_pid" 2>/dev/null
  [[ -n $tool_fifo ]] && rm -f "$tool_fifo"
  pkill -x ttfx 2>/dev/null
  pkill -f '[o]rg.omarchy.screensaver' 2>/dev/null
  exit 0
}

# Echo the command words for a chosen tool; fail for TTE/unknown/missing
# binary so the caller falls back to stock TTE.
screensaver_command() {
  case $1 in
    cmatrix) cmd="cmatrix -a" ;;
    pipes) cmd="pipes.sh" ;;
    asciiquarium) cmd="asciiquarium" ;;
    cbonsai) cmd="cbonsai -l" ;;
    rain) cmd="rain" ;;
    # No -f date format here: the format string has spaces and the caller
    # word-splits $cmd (see the ponytail note at the launch site).
    tty-clock) cmd="tty-clock -c -C 6 -r -s" ;;
    *) return 1 ;;
  esac
  command -v "${cmd%% *}" &>/dev/null || return 1
  echo "$cmd"
}

# Exit the screensaver on signals and input from keyboard and mouse
trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'  # Set background color to black

hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null

# Terminals allocate the pty at the default 80x24 and only resize it once the
# compositor has told the window how big it is. ttfx measures the terminal once,
# at startup, so starting it before the resize lands sizes an 80x24 canvas and
# paints it into the corner of a fullscreen window.
wait_for_terminal_resize() {
  local deadline=$((SECONDS + 2))
  while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
    sleep 0.02
  done
}

wait_for_terminal_resize

choice=$(cat ~/.config/omarchy/screensaver-tool 2>/dev/null || echo tte)

monitor_and_exit() {
  while kill -0 "$screensaver_pid" 2>/dev/null; do
    if read -n1 -t 1 || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done
}

if tool=$(screensaver_command "$choice"); then
  # A TUI tool: no rotation. When the tool quits on its own (e.g. cmatrix on
  # 'q'), that is the user asking to leave — exit, don't respawn.
  # ponytail: plain word-split is safe — screensaver_command emits no quotes/globs
  # The tool must NOT share the pty with our `read -n1` monitor: bash tools
  # pace frames with `read -t <delay>` on stdin (pipes, pipes.sh, rain), and
  # the monitor's termios toggling / stray reply bytes return those reads
  # early — measured 6-11x animation speedup. An empty FIFO as the tool's
  # stdin guarantees full timeouts (same fix as tm-open-all.sh's toys LOOP).
  # fd 9 holds it open so the tool's reads block instead of hitting EOF.
  tool_fifo=$(mktemp -u /tmp/omarchy-screensaver.XXXXXX)
  mkfifo "$tool_fifo"
  exec 9<>"$tool_fifo"
  $tool <"$tool_fifo" &
  screensaver_pid=$!
  monitor_and_exit
  exit_screensaver
else
  while true; do
    ttfx -i ~/.config/omarchy/branding/screensaver.txt \
      --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c\
      --random-effect --no-eol --no-restore-cursor &

    screensaver_pid=$!
    monitor_and_exit
  done
fi
