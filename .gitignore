# Restorable/regenerated content (clones via `omarchy plugin clone`) — except
# taeryn.menu, which carries hand edits (back button, rofi keys) and is the
# live SUPER+SPACE menu.
.config/omarchy/plugins/*
!.config/omarchy/plugins/taeryn.menu/
.config/omarchy/*.bak.*
.config/wlogout/colors.css
__pycache__/
*.pyc
